.venv/
.venv-setup.lock
__pycache__/
*.pyc
*.pyo
.ruff_cache/
.mypy_cache/
.pytest_cache/
*.log
*.bak
*.orig
*.swp
*.swo
.coverage
htmlcov/

# Build artifacts / release bundles - do not commit (hundreds of MB)
*.tar.gz
*.tar.xz
*.zip
*.AppImage
*.sha512sum
.appimage-build/

# Python build outputs
build/
dist/
# The workflow stages the portable download here.
/portable/
*.egg-info/
.eggs/

# Atomic-write scratch files
*.tmp

*.kate-swp
.idea/

# The bundled CLI writes here (settings.json, logs/) when run from the repo
# root without an XDG_CONFIG_HOME override - never a real project file.
/stalker-gamma/
# The CLI's relative default install folders ("gamma/anomaly") resolve here
# when COMMANDER or the tests run from the repo root - runtime state only.
/gamma/

# Exception: MAKO's GPL source archive must ship in the repo (see
# licenses/THIRD-PARTY-NOTICES.txt), so let it past the *.tar.gz rule above.
!licenses/MAKO/*-source.tar.gz

# Windows CLI, fetched by scripts/fetch_windows_cli.py
cli/win-x64/
# Generated by packaging/windows/installer/make_images.py
packaging/windows/installer/images/
